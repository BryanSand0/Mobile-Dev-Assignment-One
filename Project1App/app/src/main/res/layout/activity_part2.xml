<!-- Main Layout Container for Part 2: Vertical stack with padding -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title of the Activity -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="25dp"
        android:text="@string/title_temperature_conversion"
        android:textSize="22sp" />

    <!-- Input Section: Label and EditText for temperature entry -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/temperature_label" />

    <EditText
        android:id="@+id/editTemperaturePart2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/temperature_hint"
        android:inputType="numberDecimal|numberSigned" />

    <!-- Output Section: Displays the calculated conversion result -->
    <TextView
        android:id="@+id/textConversionPart2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/conversion_na" />

    <!-- Conversion Selection Section: Group of RadioButtons -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/select_conversion" />

    <RadioGroup
        android:id="@+id/radioGroupConversion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radioCtoF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_c_to_f" />

        <RadioButton
            android:id="@+id/radioFtoC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_f_to_c" />

    </RadioGroup>

    <!-- Action Buttons: Triggers conversion logic or resets the UI -->
    <Button
        android:id="@+id/buttonCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_calculate" />

    <Button
        android:id="@+id/buttonResetPart2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_reset" />

    <Button
        android:id="@+id/buttonPart1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_part1" />

</LinearLayout>