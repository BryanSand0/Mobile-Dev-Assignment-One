<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".LoanTermActivity">

    <TextView
        android:id="@+id/textLoanTermTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_select_term_prompt"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/termButtonsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textLoanTermTitle">

        <Button
            android:id="@+id/buttonTerm10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/term_10_years"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonTerm15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/term_15_years"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonTerm20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/term_20_years"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonTerm25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/term_25_years"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonTerm30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/term_30_years"
            android:textAllCaps="false" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonCancelTerm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/button_cancel"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/termButtonsContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
